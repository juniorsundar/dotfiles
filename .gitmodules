[submodule "nvim"]
	path = nvim/.config/nvim
	url = https://github.com/juniorsundar/nvim
[submodule "emacs"]
	path = emacs/.config/emacs
	url = https://github.com/juniorsundar/emacs
[submodule "fonts"]
	path = fonts/.local/share/fonts
	url = https://github.com/juniorsundar/fonts
[submodule "pi"]
	path = pi/.pi/agent
	url = https://github.com/juniorsundar/pi-config
[submodule "vsconsult"]
	path = vscodium-extensions/vsconsult
	url = https://github.com/juniorsundar/vsconsult.git
