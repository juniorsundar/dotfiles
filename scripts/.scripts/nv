#!/usr/bin/env bash

# tmux rejects dots in session names; keep the original readable path shape.
session_name=" ${PWD//./_}"

# --resume is for pi (pick a previous session); everything else goes to nvim.
PI_ARGS=()
NVIM_ARGS=()
for arg in "$@"; do
    if [ "$arg" = "--resume" ]; then PI_ARGS+=(--resume); else NVIM_ARGS+=("$arg"); fi
done

# Inside herdr, nvim listens on a socket named after this terminal; pi's follow extension finds
# it through NV_SOCKET and moves nvim to each change. A socket file left by a crashed nvim would
# make --listen fail, so clear it first.
LISTEN=()
if [ -z "$TMUX" ] && [ -n "$HC_TERMINAL_ID" ]; then
    export NV_SOCKET="${XDG_RUNTIME_DIR:-/tmp}/nv-$HC_TERMINAL_ID.sock"
    rm -f "$NV_SOCKET"
    LISTEN=(--listen "$NV_SOCKET")
fi

if command -v direnv &> /dev/null && [ -f ".envrc" ] && direnv export bash >/dev/null 2>&1; then
    CMD=(direnv exec . nvim "${LISTEN[@]}" "${NVIM_ARGS[@]}")
else
    CMD=(nvim "${LISTEN[@]}" "${NVIM_ARGS[@]}")
fi

if [ -n "$TMUX" ]; then
    "${CMD[@]}"
elif [ -n "$HC_TERMINAL_ID" ]; then
    # Inside herdr: nvim in a new pane, pi takes this pane.
    # herdr's pane.split has no size option, so either branch below makes the split 50/50 first and
    # herdr-split then sets 66/33 through the core, which keeps the layout (see herdr-split).
    if herdr-app status >/dev/null 2>&1; then
        # A Herdr window on this machine: split to the right of the focused pane.
        # terminal.open does not say which terminal it made, so herdr-split finds it by its socket.
        if herdr-app do terminal.open --place right --folder "$PWD" \
            --argv "$(jq -cn '$ARGS.positional' --args -- "${CMD[@]}")" >/dev/null; then
            if command -v herdr-split >/dev/null; then
                (herdr-split "$HC_TERMINAL_ID" --listen "$NV_SOCKET" >/dev/null 2>&1 </dev/null &)
            fi
            exec pi "${PI_ARGS[@]}"
        fi
    else
        # The window is on another machine (this core is remote): a terminal carrying this
        # terminal's herdr.space/herdr.tab labels shows up as a pane in the same tab.
        # --no-parent: as pi's child herdr would float it over pi when clicked.
        read -r space tab < <(hc get "$HC_TERMINAL_ID" --json 2>/dev/null |
            jq -r '[.labels["herdr.space"] // "", .labels["herdr.tab"] // ""] | @tsv')
        # hc starts programs with herdr's own PATH, which may lack nvim/direnv: pass ours.
        if [ -n "$space" ] && [ -n "$tab" ] &&
            nvim_terminal=$(hc run --bg --json --keep --no-parent --cwd "$PWD" \
                --label "herdr.space=$space" --label "herdr.tab=$tab" \
                -- env "PATH=$PATH" "${CMD[@]}" | jq -er .address); then
            # Once the window has put the new pane beside this one, make the split 66/33. It waits for
            # that in the background so pi starts at once, and gives up quietly after about 10 seconds.
            if command -v herdr-split >/dev/null; then
                (herdr-split "$HC_TERMINAL_ID" "$nvim_terminal" >/dev/null 2>&1 </dev/null &)
            fi
            exec pi "${PI_ARGS[@]}"
        fi
    fi
    echo "nv: could not open an nvim pane in herdr; opening nvim here instead." >&2
    exec "${CMD[@]}"
else
    printf -v FINAL_CMD '%q ' "${CMD[@]}"
    tmux new-session -A -s "$session_name" "$FINAL_CMD"
fi
