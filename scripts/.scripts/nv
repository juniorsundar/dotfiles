#!/usr/bin/env bash

# tmux rejects dots in session names; keep the original readable path shape.
session_name=" ${PWD//./_}"

if command -v direnv &> /dev/null && [ -f ".envrc" ] && direnv export bash >/dev/null 2>&1; then
    CMD=(direnv exec . nvim "$@")
else
    CMD=(nvim "$@")
fi

if [ -n "$TMUX" ]; then
    "${CMD[@]}"
else
    printf -v FINAL_CMD '%q ' "${CMD[@]}"
    tmux new-session -A -s "$session_name" "$FINAL_CMD"
fi
