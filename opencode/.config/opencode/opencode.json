{
    "$schema": "https://opencode.ai/config.json",
    "plugins": [
        {
            "package": "./plugins/direnv"
        },
        {
            "package": "./plugins/omniroute",
            "options": {
                "baseURL": "http://localhost:20128/v1"
            }
        }
    ],
    "permissions": [
        {
            "action": "edit",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "shell",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "external_directory",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "webfetch",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "doom_loop",
            "resource": "*",
            "effect": "ask"
        },
        {
            "action": "lsp",
            "resource": "*",
            "effect": "deny"
        }
    ],
    "mcp": {
        "servers": {
            "docker": {
                "type": "local",
                "command": [
                    "npx",
                    "-y",
                    "@alisaitteke/docker-mcp"
                ]
            }
        }
    },
    "providers": {
        "omniroute": {
            "name": "OmniRoute",
            "package": "@opencode/ai/providers/openai-compatible",
            "settings": {
                "baseURL": "http://localhost:20128/v1"
            }
        },
        "omr-office": {
            "package": "aisdk:@ai-sdk/openai-compatible",
            "name": "OmniRoute Office",
            "settings": {
                "baseURL": "http://100.77.160.81:20128/v1/",
                "apiKey": "sk-9b1556b560f39dfe-6484f7-13901139"
            },
            "headers": {
                "Authorization": "Bearer custom-token"
            },
            "models": {
                "llamacpp/gpt-oss-120b-MXFP4-00001-of-00002.gguf": {
                    "name": "GPT-OSS-120b"
                }
            }
        }
    }
}
