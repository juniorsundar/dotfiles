{
  "mcpServers": {
    "serena": {
      "command": "uvx",
      "args": [
        "-p",
        "3.13",
        "serena-agent@1.7.0",
        "start-mcp-server",
        "--context=ide",
        "--project-from-cwd"
      ],
      "lifecycle": "lazy",
      "requestTimeoutMs": 120000
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "auth": "bearer",
      "bearerTokenEnv": "CONTEXT7_API_KEY"
    }
  }
}